# ==============================================================================
# acm-db Environment Configuration Template
# Build The Internet Hackathon - Database Microservice
# ==============================================================================

# Server Network Configuration
# HOST: 0.0.0.0 allows acm-server on another laptop to reach this service over the local network
HOST=0.0.0.0
PORT=8001

# Database Configuration (SQLite file-based or custom path)
DB_PATH=users.db

# Dynamic DNS Discovery (Optional: auto-register with acm-dns on startup)
# Replace <DNS_IP> with the IP address of the laptop running acm-dns
DNS_URL=http://<DNS_IP>:8000
DNS_HOST=<DNS_IP>
DNS_PORT=8000

# Registered domain name for dynamic lookup in acm-dns
DNS_SERVICE_DOMAIN=acm-db
